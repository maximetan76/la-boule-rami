// Schéma de persistance de « La Boule ».
//
// L'état d'une Boule est déjà un objet TypeScript cohérent : il est stocké en
// JSON plutôt qu'éclaté en tables. Voir src/persistence/serialisation.ts, seul
// endroit qui écrit et relit ce JSON.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Joueur {
  id               String   @id @default(uuid())
  /// Identifiant stable fourni par Sign in with Apple (claim `sub`).
  identifiantApple String   @unique
  pseudo           String
  creeLe           DateTime @default(now())
  /// Compte supprimé à la demande du joueur : identifiant Apple détaché,
  /// pseudo anonymisé, sessions refusées. Ses parties archivées restent.
  supprimeLe       DateTime?

  parties JoueurSurPartie[]

  @@map("joueurs")
}

model Partie {
  id String @id

  /// Code d'invitation court, lisible à voix haute, sans caractères ambigus.
  codeInvitation String @unique
  createurId     String
  /// Nombre de places. La partie démarre quand elles sont toutes prises.
  capacite       Int
  demarree       Boolean @default(false)

  /// Sort d'un tour entamé par un joueur qui se déconnecte : « delai » ou
  /// « illimite ». Voir GestionDeconnexion côté serveur.
  gestionDeconnexionType    String @default("delai")
  gestionDeconnexionDureeMs Int    @default(90000)

  /// Délais de jeu, en millisecondes ; absent : illimité. Voir DelaisDeJeu
  /// côté serveur.
  delaiAnnonceMs      Int?
  delaiJeuMs          Int?
  delaiProlongationMs Int?

  /// Coups frichés de départ, choisis à la création (0 au nombre de coups de
  /// la Boule). Voir Table.coupsFrichesDepart côté serveur.
  coupsFrichesDepart Int @default(2)

  /// Coups frichés configurés par le créateur, transmis d'une Boule rejouée à
  /// la suivante ; absent : ceux du départ. Base du report en cascade.
  coupsFrichesConfigures Int?

  /// Report de coups frichés reçu au-delà du nombre de coups de cette Boule,
  /// gardé pour la Boule suivante si le groupe rejoue.
  excedentDeFriches Int @default(0)

  /// Valeur monétaire d'un point, décimal normalisé (« 0.20 ») ; absente :
  /// aucune. Texte plutôt que flottant : un montant ne s'arrondit pas en base.
  valeurPoint String?

  /// Nombre de coups de la Boule choisi à la création (1 à 12) ; absent :
  /// celui des règles pour ce nombre de joueurs.
  nombreCoups Int?

  /// Qui a abandonné la partie, et ce qu'était le coup interrompu à cet
  /// instant, mains de tous les joueurs comprises. Voir AbandonEnregistre.
  abandonneParId String?
  interruption   Json?

  creeeLe    DateTime  @default(now())
  /// Démarrage de la partie, une fois le salon complet. L'inactivité d'une
  /// partie où rien ne s'est joué se compte d'ici ; absent : `creeeLe`.
  demarreeLe DateTime?
  termineeLe DateTime?
  /// Pourquoi la partie s'est arrêtée : « abandon » ou « achevee ». Sert à
  /// dire à un joueur revenu plus tard que sa partie a été abandonnée.
  motifFin   String?

  joueurs JoueurSurPartie[]
  boule   Boule?

  @@index([termineeLe])
  @@map("parties")
}

/// Place d'un joueur autour d'une partie. `position` fige l'ordre de la table
/// issu du tirage d'ouverture.
model JoueurSurPartie {
  partieId String
  joueurId String
  position Int

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)
  joueur Joueur @relation(fields: [joueurId], references: [id], onDelete: Cascade)

  @@id([partieId, joueurId])
  @@map("joueurs_sur_partie")
}

model Boule {
  id       String @id @default(uuid())
  partieId String @unique

  /// État complet sérialisé : ordre de table, scores cumulés, croix, coups
  /// joués. Le coup en cours n'y figure pas, il est redistribué au démarrage.
  etat Json

  misAJourLe DateTime @updatedAt

  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)

  @@map("boules")
}
