# Copier en .env et renseigner les valeurs. Ce fichier ne contient que des
# exemples : aucune valeur reelle ne doit y etre commitee.

# --- Base de donnees ---------------------------------------------------------
# Chaine de connexion PostgreSQL. Sur Render, la valeur est fournie par la base
# managee (« Internal Database URL »).
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/laboule?schema=public"

# --- Signature des jetons de session -----------------------------------------
# Secret HMAC utilise pour signer les jetons de session applicatifs (HS256).
# Generer une valeur aleatoire longue, par exemple : openssl rand -base64 48
# La changer invalide toutes les sessions en cours.
# OBLIGATOIRE en production. En developpement, son absence fait tirer un secret
# ephemere au demarrage : les sessions ne survivent alors pas a un redemarrage.
JWT_SECRET="a-remplacer-par-un-secret-aleatoire-long"

# --- Sign in with Apple ------------------------------------------------------
# Identifiant du service Apple, audience attendue dans le jeton d'identite.
# C'est le Bundle ID de l'app iOS, ou le Services ID declare sur le portail
# developpeur Apple.
# OPTIONNEL : sans lui, le serveur demarre quand meme et tout fonctionne, sauf
# POST /auth/apple qui repond 503. Utile tant que l'app iOS n'existe pas encore.
APPLE_CLIENT_ID="fr.exemple.laboule"

# --- Serveur -----------------------------------------------------------------
# Port d'ecoute. Render fournit PORT automatiquement, ne pas le definir la-bas.
PORT="3000"
# Origines autorisees pour les connexions WebSocket. « * » convient tant que le
# seul client est l'app iOS ; a restreindre des qu'un client web existe.
CORS_ORIGIN="*"
